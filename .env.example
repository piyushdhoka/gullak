# Supabase project the app talks to. Both values are public (row-level security protects the data).
# Defaults point at the Gullak project; set these to run your own.
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Where the iOS Shortcut posts SMS. Defaults to <site>/ingest on the live site, else the ingest function.
# EXPO_PUBLIC_INGEST_URL=

# Show sample data with no backend:
# EXPO_PUBLIC_DEMO=1
