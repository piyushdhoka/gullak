{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
